
DROP TABLE IF EXISTS reviews, products, brands, categories CASCADE;

CREATE TABLE categories (
    id         INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name       VARCHAR(100) NOT NULL UNIQUE,
    slug       VARCHAR(100) NOT NULL UNIQUE,
    image_url  TEXT
);

CREATE TABLE brands (
    id        INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name      VARCHAR(100) NOT NULL UNIQUE,
    logo_url  TEXT
);

CREATE TABLE products (
    id                 INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    sku                VARCHAR(20)   NOT NULL UNIQUE,
    name               VARCHAR(200)  NOT NULL,
    brand_id           INT NOT NULL  REFERENCES brands(id)     ON DELETE RESTRICT,
    category_id        INT NOT NULL  REFERENCES categories(id) ON DELETE RESTRICT,
    unit_size          NUMERIC(10,2) NOT NULL CHECK (unit_size > 0),
    unit               VARCHAR(10)   NOT NULL CHECK (unit IN ('g','kg','ml','l','pcs')),
    price              NUMERIC(10,2) NOT NULL CHECK (price >= 0),              -- actual price (₹)
    discount_percent   INT           NOT NULL DEFAULT 0
                       CHECK (discount_percent BETWEEN 0 AND 100),
    quantity           INT           NOT NULL DEFAULT 0 CHECK (quantity >= 0), -- units in stock
    image_url          TEXT,
    shelf_life_days    INT           CHECK (shelf_life_days > 0),              -- NULL = doesn't expire
    manufactured_date  DATE,
    expiry_date        DATE,
    created_at         TIMESTAMPTZ   NOT NULL DEFAULT now(),
    CONSTRAINT expiry_after_mfg
        CHECK (expiry_date IS NULL OR manufactured_date IS NULL OR expiry_date >= manufactured_date)
);

CREATE INDEX idx_products_brand    ON products (brand_id);
CREATE INDEX idx_products_category ON products (category_id);
CREATE INDEX idx_products_expiry   ON products (expiry_date);

CREATE TABLE reviews (
    id             INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    product_id     INT NOT NULL REFERENCES products(id) ON DELETE CASCADE,
    reviewer_name  VARCHAR(100) NOT NULL,
    is_verified    BOOLEAN      NOT NULL DEFAULT false,   -- verified buyer
    rating         SMALLINT     NOT NULL CHECK (rating BETWEEN 1 AND 5),
    review_text    TEXT         NOT NULL,
    created_at     TIMESTAMPTZ  NOT NULL DEFAULT now()
);

CREATE INDEX idx_reviews_product ON reviews (product_id);


create  view avg_ratings AS
select product_id, ROUND(AVG(rating)::numeric,2) as avg_rating from reviews group by product_id order by product_id asc;


CREATE OR REPLACE VIEW view_product_details AS
SELECT
    p.id,
    p.sku,
    p.name,
    p.brand_id,
    b.name AS brand_name,
    p.category_id,
    c.slug AS category_name,
    p.unit_size,
    p.unit,
    p.price,
    p.discount_percent,
    p.quantity,
    p.image_url,
    p.shelf_life_days,
    p.manufactured_date,
    p.expiry_date,
    r.avg_rating,

    CASE
        WHEN p.expiry_date < CURRENT_DATE THEN 'EXPIRED'
        WHEN p.quantity = 0 THEN 'OUT_OF_STOCK'
        ELSE 'AVAILABLE'
    END AS availability_status

FROM products AS p
JOIN brands AS b
    ON b.id = p.brand_id
JOIN categories AS c
    ON c.id = p.category_id
LEFT JOIN avg_ratings AS r
    ON p.id = r.product_id
ORDER BY p.id ASC;



	
CREATE TABLE users (
    user_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    username VARCHAR(100) NOT NULL UNIQUE,
    fullname VARCHAR(255)  NULL,
    email TEXT NOT NULL UNIQUE,
    phone VARCHAR(20) NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    account_status VARCHAR(20) NOT NULL DEFAULT 'CUSTOMER',
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT users_account_status_check
        CHECK (account_status IN ('CUSTOMER', 'ADMIN'))   
);



CREATE TABLE cart_items (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    user_id BIGINT NOT NULL
        REFERENCES users(user_id) ON DELETE CASCADE,

    product_id INT NOT NULL
        REFERENCES products(id) ON DELETE CASCADE,

    quantity_selected INT NOT NULL
        CHECK (quantity_selected > 0),

    price NUMERIC(10,2) NOT NULL
        CHECK (price >= 0),

    discount_percent INT NOT NULL DEFAULT 0
        CHECK (discount_percent BETWEEN 0 AND 100),

    discounted_unit_price NUMERIC(10,2)
        GENERATED ALWAYS AS (
            ROUND(
                price * (1 - discount_percent::NUMERIC / 100),
                2
            )
        ) STORED,

    total_price NUMERIC(12,2)
        GENERATED ALWAYS AS (
            ROUND(
                price * (1 - discount_percent::NUMERIC / 100)
                * quantity_selected,
                2
            )
        ) STORED,

    UNIQUE (user_id, product_id)
);

CREATE TABLE orders (
    id            BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    user_id       BIGINT NOT NULL REFERENCES users(user_id) ON DELETE RESTRICT,
    status        VARCHAR(20) NOT NULL DEFAULT 'placed'
                  CHECK (status IN ('placed', 'shipped', 'delivered', 'cancelled')),
    total_amount  NUMERIC(10,2) NOT NULL CHECK (total_amount >= 0),
    placed_at     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE order_items (
    id                BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,  
    order_id          BIGINT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    product_id        INT REFERENCES products(id) ON DELETE SET NULL,
    product_name      VARCHAR(200)  NOT NULL,    -
    unit_price        NUMERIC(10,2) NOT NULL,   
    discount_percent  INT           NOT NULL DEFAULT 0,
    quantity          INT           NOT NULL CHECK (quantity > 0),
    line_total     NUMERIC(12,2) NOT NULL
       
);

CREATE TABLE wishlist (
    id          BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    user_id     BIGINT NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    product_id  INT    NOT NULL REFERENCES products(id) ON DELETE CASCADE,
    UNIQUE (user_id, product_id)    -- one row per product per user
);


CREATE OR REPLACE VIEW view_wishlist_reviews AS
SELECT
    r.id,
    w.product_id,
    r.reviewer_name,
    r.is_verified,
    r.rating,
    r.review_text,
    w.user_id
FROM reviews AS r
JOIN wishlist AS w
    ON r.product_id = w.product_id;


CREATE OR REPLACE VIEW view_cart_details AS
SELECT
    c.id AS cart_id,
    c.user_id,
    c.product_id,
    p.name AS product_name,
    p.brand_name,
    c.quantity_selected,
    p.quantity,
    p.price,
    p.discount_percent,
    c.discounted_unit_price,
    c.total_price,
    p.expiry_date,

    CASE
        WHEN p.expiry_date < CURRENT_DATE THEN 'EXPIRED'
        WHEN p.quantity = 0 THEN 'OUT_OF_STOCK'
        WHEN c.quantity_selected > p.quantity THEN 'INSUFFICIENT_STOCK'
        ELSE 'AVAILABLE'
    END AS availability_status

FROM cart_items AS c
JOIN view_product_details AS p
    ON c.product_id = p.id;


CREATE OR REPLACE FUNCTION deduct_product_stock()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
 UPDATE products
 SET quantity = quantity - NEW.quantity
 WHERE id = NEW.product_id and quantity >= NEW.quantity;

 IF NOT FOUND THEN
 	RAISE EXCEPTION 
	 	'insufficient stock or invalid product  for product ID %',NEW.product_id;
 END IF;


 RETURN NEW;
END;
$$;


CREATE TRIGGER trg_deduct_product_stock
AFTER INSERT ON order_items
FOR EACH ROW
EXECUTE FUNCTION deduct_product_stock();