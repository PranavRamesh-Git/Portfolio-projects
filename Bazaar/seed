INSERT INTO reviews (product_id, reviewer_name, is_verified, rating, review_text, created_at)
SELECT p.id,
       (ARRAY['Priya S','Arjun K','Meena R','Karthik V','Divya N','Rahul M','Anitha P',
              'Suresh B','Lakshmi T','Vikram J','Sneha G','Rohan D','Kavya L','Aditya P',
              'Fatima Z','Joseph M','Harini S','Imran K','Neha T','Ganesh R'])[1 + (p.id * 7 + g * 3) % 20],
       (p.id + g) % 3 <> 0,
       t.rating,
       t.review_text,
       now() - make_interval(days => (p.id * 3 + g * 11) % 120,
                             hours => (p.id + g * 5) % 24)
FROM products p
JOIN categories c ON c.id = p.category_id
CROSS JOIN generate_series(1, 4) AS g
JOIN (VALUES
    ('food', 5, 0, 'Excellent quality and very fresh. Will definitely buy again.'),
    ('food', 5, 1, 'Tastes great and the whole family loved it. Good value for money.'),
    ('food', 4, 0, 'Good product for the price. Packaging could be a little better.'),
    ('food', 4, 1, 'Fresh and well packed. Delivery was quick too.'),
    ('food', 3, 0, 'It is okay. Nothing special compared to other brands.'),
    ('food', 3, 1, 'Average taste. Expected a bit more for this price.'),
    ('food', 2, 0, 'Quality was below what I expected this time.'),
    ('food', 2, 1, 'Received it close to the expiry date. Not happy.'),
    ('food', 1, 0, 'Did not like it at all. Would not recommend.'),
    ('food', 1, 1, 'Packet was damaged and the product was stale.'),
    ('home', 5, 0, 'Works perfectly and feels very well made. Highly recommended.'),
    ('home', 5, 1, 'Excellent value. Exactly as described and easy to use.'),
    ('home', 4, 0, 'Good quality overall. Does the job well.'),
    ('home', 4, 1, 'Nice product, though it is slightly smaller than I expected.'),
    ('home', 3, 0, 'Decent, but there are better options at this price.'),
    ('home', 3, 1, 'Okay for daily use. Nothing exceptional.'),
    ('home', 2, 0, 'Build quality feels cheap. Not sure it will last.'),
    ('home', 2, 1, 'Stopped working properly after a few weeks.'),
    ('home', 1, 0, 'Arrived damaged. Very disappointed.'),
    ('home', 1, 1, 'Waste of money. Would not buy again.')
) AS t(grp, rating, variant, review_text)
  ON  t.grp = CASE WHEN c.slug IN ('fruits-vegetables','dairy-eggs','bakery','meat-seafood',
                                    'staples','oils-ghee','spices','snacks','beverages',
                                    'breakfast','chocolates-sweets','frozen','pet-care')
                   THEN 'food' ELSE 'home' END
  AND t.rating  = (ARRAY[5,4,5,3,4,5,2,4,1,5,4,3])[1 + (p.id * 5 + g * 7) % 12]
  AND t.variant = (p.id + g) % 2
WHERE p.id % 9 <> 0            -- every 9th product has no reviews yet
  AND (p.id * g) % 5 <> 0;     -- vary how many each product gets

