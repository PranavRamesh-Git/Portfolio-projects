-- Turns "Lay's Magic Masala" into "Lays+Magic+Masala" for the URL
CREATE FUNCTION pg_temp.url_text(t TEXT) RETURNS TEXT AS $$
    SELECT regexp_replace(
               trim(regexp_replace(translate(t, 'é''', 'e'), '[^A-Za-z0-9 ]', ' ', 'g')),
               '\s+', '+', 'g');
$$ LANGUAGE sql IMMUTABLE;

