-- Expiry: products with a shelf life get a manufactured_date in the
-- past and expiry_date = manufactured_date + shelf_life_days.
-- Everything starts fresh; specific items are adjusted below.

UPDATE products
SET manufactured_date = CURRENT_DATE - ((id * 7) % GREATEST(shelf_life_days - 1, 1))
WHERE shelf_life_days IS NOT NULL;

UPDATE products
SET expiry_date = manufactured_date + shelf_life_days
WHERE shelf_life_days IS NOT NULL;

-- Already expired (negative) and expiring soon (0–3 days) — for testing
UPDATE products p
SET expiry_date       = CURRENT_DATE + v.days_left,
    manufactured_date = CURRENT_DATE + v.days_left - p.shelf_life_days
FROM (VALUES
    ('FV-007', -2), ('FV-010', -1), ('DE-001', -1), ('BK-001', -3), ('MS-003', -1),
    ('DE-008', -5), ('BV-006', -10), ('BK-005', -7), ('SN-007', -4),
    ('DE-009',  0), ('MS-001',  1), ('DE-004',  1), ('FV-001',  2), ('DE-005',  2),
    ('BK-009',  1), ('FV-003',  3), ('DE-006',  3), ('FZ-004',  3)
) AS v(sku, days_left)
WHERE p.sku = v.sku;

