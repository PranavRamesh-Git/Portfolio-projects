-- 4. SAFETY GUARD
DO $$
BEGIN
    IF EXISTS (
        SELECT 1
        FROM monitoring_alert a
        JOIN monitoring_sensor s ON s.id = a.sensor_id
        JOIN monitoring_machine m ON m.id = s.machine_id
        WHERE m.asset_tag IN (
            'A-101', 'A-102', 'A-103', 'A-104',
            'B-201', 'B-202', 'B-203'
        )
    )
    OR EXISTS (
        SELECT 1
        FROM monitoring_reading r
        JOIN monitoring_sensor s ON s.id = r.sensor_id
        JOIN monitoring_machine m ON m.id = s.machine_id
        WHERE m.asset_tag IN (
            'A-101', 'A-102', 'A-103', 'A-104',
            'B-201', 'B-202', 'B-203'
        )
    )
    THEN
        RAISE EXCEPTION
            'Sample machines already have readings or alerts.';
    END IF;
END $$;


